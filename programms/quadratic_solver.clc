in #read input val and stored it in R1
pop R1
 
call :factorial #calculate fact and put calculated value in R2

pushr R1
out
hlt

:factorial 
	pushr R1 #get val from Reg1
	push 0

	je :exist #if val = 0, return 1

	push 1    #decrement R1
	pushr R1
	sub
	pop R1

	call :factorial #in R2 stored fact(R1 - 1)

	pushr R2    # R1 * fact(R1 - 1), what is exactly fact(R1)
	pushr R1
	mult

	pop R2 #stored it in R2

	:exit       #return 1
		ret